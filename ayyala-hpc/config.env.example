# Copy to config.env and use a real absolute path on shared scratch/project storage.
# The repository location is detected automatically.
export UNITREE_WORKDIR=/scratch/your_username/ayyala_mjlab

# Match your cluster's partition, allocation, and GPU resource names.
export SLURM_PARTITION=gpu
export SLURM_ACCOUNT=your_allocation
export SLURM_GRES=gpu:a5000:1
# If your cluster does not require an account, use SLURM_ACCOUNT="".

export NUM_ENVS=4096
export MAX_ITERATIONS=30000
export SEED=42
export SMOKE_NUM_ENVS=512
export SMOKE_MAX_ITERATIONS=50

# If needed, set the cluster's absolute Conda executable path.
# export CONDA_EXE=/shared/apps/miniconda/bin/conda
# Optional: place evaluation outputs on shared scratch instead of in the repo.
# export RESULTS_ROOT=/scratch/your_username/ayyala_results
