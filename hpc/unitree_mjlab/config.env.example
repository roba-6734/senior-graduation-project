# Copy this file to config.env and replace the paths for the shared HPC.
# Do not commit account names, tokens, or other cluster secrets.

export PROJECT_ROOT=/shared/path/to/seniorproject
export UNITREE_WORKDIR=/scratch/your_username/ayyala_mjlab

# Optional scheduler settings used by submit_pipeline.sh.
export SLURM_PARTITION=gpu
export SLURM_ACCOUNT=your_allocation
export SLURM_GRES=gpu:a5000:1

# A5000 24 GB starting points. Reduce NUM_ENVS if CUDA runs out of memory.
export NUM_ENVS=4096
export MAX_ITERATIONS=30000
export SEED=42

# Use a cluster-provided Conda executable when it is not already on PATH.
# export CONDA_EXE=/shared/apps/miniconda/bin/conda
